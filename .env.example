# Copy to .env (gitignored) and fill in. Names match what config.yaml
# references via *_env fields; rename here if you renamed there.

# Long-lived HA access token. Create at:
#   <ha-url>/profile/security  →  Long-lived access tokens
HA_TOKEN=

# Optional. Only set for weather providers that require a key
# (pirate, openweathermap). Open-Meteo's free tier doesn't need one.
# WEATHER_API_KEY=
